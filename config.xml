<?xml version='1.0' encoding='utf-8'?>
<widget id="com.geez.calculator" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Geez Calculator</name>
    <description>Calculator with real Ge'ez numerals</description>
    <author email="you@example.com">Geez Calculator</author>
    <content src="index.html" />
    <icon src="res/icon.png" />
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="BackgroundColor" value="0xff000000" />
    <preference name="DisallowOverscroll" value="true" />
    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="AndroidPersistentFileLocation" value="Compatibility" />
        <icon src="res/icon.png" density="xxxhdpi" />
    </platform>
</widget>
